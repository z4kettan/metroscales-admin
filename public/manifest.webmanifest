{
  "name": "Metro Scales Admin",
  "short_name": "MS Admin",
  "description": "Manage Metro Scales customers, their logins and their scales.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7faf8",
  "theme_color": "#0f766e",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Customers", "url": "/customers", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scales", "url": "/scales", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
